# RustDesk Server environment (sourced by systemd EnvironmentFile)

# hbbs/hbbr working directory (stores id_ed25519 keypair and db files)
RUSTDESK_DATA_DIR=/var/lib/rustdesk-server

# Optional: public address advertised to clients (-r argument of hbbs),
# e.g. the NAS WAN/DDNS address. Leave empty to auto-detect.
RUSTDESK_PUBLIC_ADDR=

# Protocol ports (fixed by RustDesk client protocol, opened by the services):
#   TCP 21114-21119, UDP 21116 (hbbs); TCP 21117 (hbbr)
