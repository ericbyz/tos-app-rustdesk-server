[zh-cn]
name = "RustDesk 自建远控中继"
auth = "ericbyz"
descript = "在 NAS 上自建 RustDesk 远控服务端:hbbs(ID/信令)+ hbbr(中继),远控流量全部走自己的网络。上游二进制原样封装(AGPL-3.0),悬浮窗内置客户端配置说明页(ID 服务器地址、端口 21114-21119、公钥查看)。服务开机自启,密钥保存于 /var/lib/rustdesk-server。"
note = "1. 将上游 rustdesk/rustdesk-server(AGPL-3.0)原样封装为 TOS 应用。"

[zh-hk]
name = "RustDesk 自建遠控中繼"
auth = "ericbyz"
descript = "在 NAS 上自建 RustDesk 遠控服務端:hbbs(ID/信令)+ hbbr(中繼),遠控流量全部走自己的網絡。上游二進制原樣封裝(AGPL-3.0),懸浮窗內置客戶端配置說明頁(ID 服務器地址、端口 21114-21119、公鑰查看)。服務開機自啟,密鑰保存於 /var/lib/rustdesk-server。"
note = "1. 将上游 rustdesk/rustdesk-server(AGPL-3.0)原样封装为 TOS 应用。"

[en-us]
name = "RustDesk Server"
auth = "ericbyz"
descript = "Self-hosted RustDesk remote-desktop server (hbbs ID/signalling + hbbr relay), packaged unmodified from upstream rustdesk/rustdesk-server (AGPL-3.0). Remote desktop sessions stay inside your network. Ships a floating-window instruction page with the client configuration (ID server, ports 21114-21119, public key)."
note = "1. Repackaged upstream rustdesk/rustdesk-server (AGPL-3.0) unmodified for TOS."

[ko-kr]
name = "RustDesk Server"
auth = "ericbyz"
descript = "NAS에서 RustDesk 원격 데스크톱 서버를 셀프 호스팅: hbbs(ID/시그널링) + hbbr(릴레이)로 원격 세션 트래픽을 모두 자신의 네트워크 안에 유지합니다. 업스트림 바이너리를 무수정 패키징(AGPL-3.0)하며, 플로팅 창에 클라이언트 설정(ID 서버, 포트 21114-21119, 공개 키) 안내 페이지를 제공합니다."
note = "1. Repackaged upstream rustdesk/rustdesk-server (AGPL-3.0) unmodified for TOS."

[ja-jp]
